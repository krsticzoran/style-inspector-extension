{
  "manifest_version": 3,
  "name": "Style Inspector",
  "version": "1.0",
  "description": "Shows the computed text styles of the element under the cursor in a tooltip that follows the mouse.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-inspector": {
      "suggested_key": { "default": "Alt+S", "mac": "Alt+S" },
      "description": "Toggle the style inspector on or off"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}
