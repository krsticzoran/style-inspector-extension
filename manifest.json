{
  "manifest_version": 3,
  "name": "Style Inspector",
  "version": "1.0",
  "description": "Hover preko teksta i vidi font, veličinu, boju i ostale stilove.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
